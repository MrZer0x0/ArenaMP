# ArenaMP bundled server core
# The generic `data` rule above also matches server/data. Re-include this
# directory so its seed files and empty runtime folders are committed.
!/server/data/


# ArenaMP: vendored Rubic0n LuaJIT 2.1 is REAL SOURCE, not build output.
# The generic Makefile/build*/*.a patterns above must not drop its sources.
# Generated LuaJIT products remain excluded by extern/LuaJIT/src/.gitignore.
!/extern/LuaJIT/
!/extern/LuaJIT/**

# Private signing and local secrets must never be committed.
*.jks
*.keystore
*.p12
*.pfx
**/signing.properties
.env
.env.*

# Generated packaging outputs (not source).
/release-input/
/release-assets/

# Rubic0n uses authored Makefiles (not build outputs).
!/extern/LuaJIT/Makefile
!/extern/LuaJIT/src/Makefile
!/extern/LuaJIT/src/Makefile.dep

# Public source repository contains no mobile build tree.
/android/

# Breakpad carries authored `build/` GYP recipes and vendored fixtures.
# Those source files must not be silently omitted by generic build/binary rules.
!/extern/breakpad/
!/extern/breakpad/**
