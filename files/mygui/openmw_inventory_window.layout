<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Window_Pinnable" layer="Windows" position="0 0 600 300" name="_Main">
        <Property key="MinSize" value="360 220"/>

        <Widget type="Widget" skin="" position="0 0 224 223" align="Left Top" name="LeftPane">
            <!-- Paper doll only. Encumbrance was moved to the shared bottom bar. -->
            <Widget type="Widget" skin="MW_Box" position="8 8 212 215" name="Avatar" align="Left Top Stretch">
                <Widget type="ImageBox" skin="ImageBox" position="3 3 206 188" align="Stretch" name="AvatarImage">
                    <UserString key="ToolTipType" value="AvatarItemSelection"/>
                </Widget>
                <Widget type="TextBox" skin="ProgressText" position="0 191 212 24" align="HStretch Bottom" name="ArmorRating">
                    <Property key="NeedMouse" value="false"/>
                </Widget>
            </Widget>
        </Widget>

        <Widget type="Widget" skin="" position="228 0 350 223" align="Left Top" name="RightPane">
            <!-- IV1: filters are a column at the left edge of this pane: paper doll |
                 filters | list, or filters | list without the doll.
                 InventoryWindow::setupFilterIcons adds the icons and tooltips;
                 layoutFilterColumn sizes the column to the window. -->
            <Widget type="Widget" skin="" position="0 8 34 179" align="Left Top VStretch" name="Categories">
                <Widget type="Button" skin="MW_Button" position="0 0 34 28" name="AllButton">
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="Button" skin="MW_Button" position="0 30 34 28" name="WeaponButton">
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="Button" skin="MW_Button" position="0 60 34 28" name="ApparelButton">
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="Button" skin="MW_Button" position="0 90 34 28" name="MagicButton">
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="Button" skin="MW_Button" position="0 120 34 28" name="MiscButton">
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="Button" skin="MW_Button" position="0 150 34 28" name="KeysButton">
                    <Property key="NeedKey" value="false"/>
                </Widget>
            </Widget>

            <!-- Items in inventory: everything right of the filters, above the bottom strip. -->
            <Widget type="ItemView" skin="MW_ItemView" position="38 8 312 179" name="ItemView" align="Left Top Stretch">
            </Widget>

            <!-- Bottom strip: paper doll, used weight, view mode and search.
                 The key ring itself is a virtual item inside ItemView. -->
            <Widget type="Widget" skin="" position="0 191 350 32" align="Left Bottom HStretch" name="BottomBar">
                <Widget type="MWDynamicStat" skin="MW_ChargeBar_Blue" position="80 7 104 18" name="EncumbranceBar" align="Left Top">
                </Widget>
                <Widget type="EditBox" skin="MW_TextBoxEditWithBorder" position="220 4 130 24" name="FilterEdit" align="Left Top HStretch">
                    <UserString key="AcceptTab" value="true"/>
                </Widget>
            </Widget>
        </Widget>
    </Widget>
</MyGUI>
