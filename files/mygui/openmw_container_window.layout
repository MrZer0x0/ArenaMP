<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Window" layer="Windows" position="0 0 680 365" name="_Main">
        <Property key="MinSize" value="560 340"/>
        <Property key="Visible" value="false"/>

        <!-- UI8: the same filter column as the player inventory: six icon
             buttons left of the list (laid out by ArenaUi::layoutFilterColumn,
             names in the tooltips). The strip below starts under the list. -->
        <Widget type="Widget" skin="" position="8 8 34 276" align="Left Top VStretch" name="Categories">
            <Widget type="Button" skin="MW_Button" position="0 0 34 28" name="AllButton">
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="Button" skin="MW_Button" position="0 32 34 28" name="WeaponButton">
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="Button" skin="MW_Button" position="0 64 34 28" name="ApparelButton">
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="Button" skin="MW_Button" position="0 96 34 28" name="MagicButton">
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="Button" skin="MW_Button" position="0 128 34 28" name="MiscButton">
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="Button" skin="MW_Button" position="0 160 34 28" name="KeysButton">
                <Property key="NeedKey" value="false"/>
            </Widget>
        </Widget>

        <Widget type="ItemView" skin="MW_ItemView" position="46 8 608 276" name="ItemView" align="Left Top Stretch"/>

        <Widget type="Widget" skin="" position="46 292 608 28" align="Left Bottom HStretch" name="BottomBar">
            <Widget type="MWDynamicStat" skin="MW_ChargeBar_Blue" position="0 2 122 24" name="EncumbranceBar" align="Left Top"/>
            <Widget type="AutoSizedButton" skin="MW_Button" position="160 2 0 24" name="SingleTransferButton" align="Left Top">
                <Property key="Caption" value="#{arenamp=inventory.single_transfer_on}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="EditBox" skin="MW_TextBoxEditWithBorder" position="276 2 212 24" name="FilterEdit" align="Left Top HStretch">
                <Property key="MultiLine" value="false"/>
                <UserString key="AcceptTab" value="true"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" position="498 2 0 24" name="TakeButton" align="Right Top">
                <Property key="Caption" value="#{sTakeAll}"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" position="590 2 0 24" name="CloseButton" align="Right Top">
                <Property key="Caption" value="#{sClose}"/>
            </Widget>
        </Widget>
    </Widget>
</MyGUI>
