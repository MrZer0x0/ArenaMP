<?xml version="1.0" encoding="UTF-8"?>
<MyGUI type="Layout">
    <Widget type="Widget" layer="LoadingScreen" position="0 0 800 600" name="_Main" align="Stretch">
        <Widget type="Widget" skin="FullBlackBG" position="0 0 800 600" align="Stretch" name="BlackBackground">
            <Property key="NeedMouseFocus" value="false"/>
        </Widget>
        <Widget type="Widget" position="0 0 800 600" align="Stretch" name="LoadingBox">
            <Widget type="Widget" position="40 360 720 176" name="LoadingPanel">
                <Property key="NeedMouseFocus" value="false"/>
                <Property key="NeedKeyFocus" value="false"/>
                <Widget type="Widget" skin="MW_Dialog" position="0 0 720 176" align="Stretch" name="LoadingFrame">
                    <Property key="NeedMouseFocus" value="false"/>
                    <Property key="NeedKeyFocus" value="false"/>
                </Widget>
                <Widget type="TextBox" skin="SandText" position="24 24 664 26" name="LoadingTipTitle">
                    <Property key="FontName" value="ArenaLoadingFont"/>
                    <Property key="FontHeight" value="18"/>
                    <Property key="TextAlign" value="HCenter VCenter"/>
                    <Property key="TextShadow" value="true"/>
                    <Property key="TextShadowColour" value="0 0 0"/>
                    <Property key="NeedMouseFocus" value="false"/>
                    <Property key="NeedKeyFocus" value="false"/>
                </Widget>
                <Widget type="TextBox" skin="SandText" position="24 24 664 80" name="LoadingTip">
                    <Property key="FontName" value="ArenaLoadingFont"/>
                    <Property key="TextAlign" value="HCenter VCenter"/>
                    <!-- Wrapping is enabled on the TextBox subwidget in C++. -->
                    <Property key="FontHeight" value="18"/>
                    <Property key="TextShadow" value="true"/>
                    <Property key="TextShadowColour" value="0 0 0"/>
                    <Property key="NeedMouseFocus" value="false"/>
                    <Property key="NeedKeyFocus" value="false"/>
                </Widget>
                <Widget type="ProgressBar" skin="ArenaHUD_Bar_Magicka" position="107 126 498 18" name="ProgressBar">
                    <Property key="NeedMouseFocus" value="false"/>
                    <Property key="NeedKeyFocus" value="false"/>
                </Widget>
                <Widget type="TextBox" skin="SandBrightText" position="107 126 498 18" name="ProgressText">
                    <Property key="FontHeight" value="15"/>
                    <Property key="TextAlign" value="HCenter VCenter"/>
                    <Property key="TextShadow" value="true"/>
                    <Property key="TextShadowColour" value="0 0 0"/>
                    <Property key="NeedMouseFocus" value="false"/>
                    <Property key="NeedKeyFocus" value="false"/>
                </Widget>
            </Widget>
        </Widget>
    </Widget>
</MyGUI>
