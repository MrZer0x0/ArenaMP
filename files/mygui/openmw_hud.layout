<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Layout">
    <Widget type="Widget" layer="HUD" position="0 0 300 200" name="_Main" align="Stretch">
        <!-- All gameplay HUD widgets are grouped so they can remain hidden through the complete login/registration flow. -->
        <Widget type="Widget" position="0 0 300 200" name="GameplayHud" align="Stretch">
            <Property key="NeedMouse" value="false"/>
	
        <Widget type="TextBox" skin="SandBrightText" position="12 8 120 24" name="FpsText" align="Left Top">
            <Property key="NeedMouse" value="false"/>
            <Property key="TextAlign" value="Left VCenter"/>
            <Property key="TextShadow" value="true"/>
            <Property key="TextShadowColour" value="0 0 0"/>
            <Property key="FontName" value="Russo"/>
            <Property key="FontHeight" value="16"/>
            <Property key="Caption" value="FPS: --"/>
        </Widget>

        <!-- Engine-native horizontal compass; tick labels are populated by HUD.cpp. -->
        <!-- UI4: dark band that fades out at both ends, bronze rules (TESO-like). -->
        <Widget type="Widget" skin="ArenaHUD_CompassBand" position="0 8 420 26" name="HorizontalCompass" align="HCenter Top">
            <Property key="Visible" value="false"/>
            <Property key="NeedMouse" value="false"/>
            <!-- Soft inner shade keeps compass marks readable without making the bar visually heavy. -->
            <Widget type="Widget" skin="" position="2 2 416 22" name="HorizontalCompassShade" align="Stretch">
                <Property key="NeedMouse" value="false"/>
            </Widget>
        </Widget>

        <!-- Energy bars -->
        
        <!-- Compact target panel above the player's health bar -->
        <Widget type="TextBox" skin="SandText" position="0 0 240 20" align="Left Top" name="EnemyName">
            <Property key="NeedMouse" value="false"/>
            <Property key="TextAlign" value="Center"/>
            <Property key="TextShadow" value="true"/>
            <Property key="TextShadowColour" value="0 0 0"/>
            <Property key="Visible" value="false"/>
        </Widget>
        <Widget type="ProgressBar" skin="ArenaHUD_Bar_Health" position="0 0 190 16" align="Left Top" name="EnemyHealth">
            <Property key="NeedMouse" value="false"/>
            <Property key="Visible" value="false"/>
        </Widget>
        <Widget type="TextBox" skin="SandBrightText" position="0 0 190 16" align="Left Top" name="EnemySummary">
            <Property key="NeedMouse" value="false"/>
            <Property key="TextAlign" value="Center"/>
            <Property key="TextShadow" value="true"/>
            <Property key="TextShadowColour" value="0 0 0"/>
            <Property key="Visible" value="false"/>
        </Widget>
		
		 
   <!-- WE -->



        <Widget type="Button" skin="" position="100 164 200 26" align="Left Bottom" name="MagickaFrame">
            <UserString key="ToolTipType" value="Layout"/>
            <UserString key="ToolTipLayout" value="HealthToolTip"/>
            <UserString key="ImageTexture_HealthImage" value="icons\k\magicka.dds"/>
            <Widget type="ProgressBar" skin="ArenaHUD_Bar_Magicka" position="0 4 170 17" align="Right Bottom" name="Magicka">
                <Property key="NeedMouse" value="false"/>
            </Widget>
            <Widget type="TextBox" skin="SandBrightText" position="0 4 170 17" align="Right Bottom" name="MagickaText">
                <Property key="FontHeight" value="15"/>
                <Property key="NeedMouse" value="false"/>
                <Property key="TextAlign" value="Center"/>
                <Property key="TextShadow" value="true"/>
                <Property key="TextShadowColour" value="0 0 0"/>
                <Property key="Caption" value="0/0"/>
            </Widget>
			<Widget type="ProgressBar" skin="ArenaHUD_ThinBar_Cast" position="6 21 158 5" align="Right Bottom" name="SpellStatus">
                <Property key="NeedMouse" value="false"/>
            </Widget>
			
			        <!-- Selected spell box -->
        <Widget type="Button" skin="" position="174 0 26 26" align="Left Bottom" name="SpellBox">
            <!-- Centered 16 px icon above icon_disc; icon_ring is drawn last
                 to frame it, keeping its corners inside the outer circle. -->
            <Widget type="Widget" skin="" position="0 0 26 26" name="SpellRing">
                <Property key="Visible" value="false"/>
                <Property key="NeedMouse" value="false"/>
                <Widget type="ImageBox" skin="ImageBox" position="0 0 26 26">
                    <Property key="ImageTexture" value="textures\ui\arenamw\hud\icon_disc.png"/>
                    <Property key="NeedMouse" value="false"/>
                </Widget>
                <Widget type="SpellWidget" skin="ArenaHUD_RoundIcon" position="5 5 16 16" name="SpellImage">
                    <Property key="NeedMouse" value="false"/>
                </Widget>
                <Widget type="ImageBox" skin="ImageBox" position="0 0 26 26">
                    <Property key="ImageTexture" value="textures\ui\arenamw\hud\icon_ring.png"/>
                    <Property key="NeedMouse" value="false"/>
                </Widget>
            </Widget>
        </Widget>

        </Widget>


		 <!-- HP -->
        <Widget type="Button" skin="" position="45 170 190 20" align="Center Bottom" name="HealthFrame">
            <UserString key="ToolTipType" value="Layout"/>
            <UserString key="ToolTipLayout" value="HealthToolTip"/>
            <UserString key="ImageTexture_HealthImage" value="icons\k\health.dds"/>
            <Widget type="ProgressBar" skin="ArenaHUD_Bar_Health" position="0 0 190 18" align="Center Bottom" name="Health">
                <Property key="NeedMouse" value="false"/>
                        </Widget>
            <Widget type="TextBox" skin="SandBrightText" position="0 0 190 18" align="Center Bottom" name="HealthText">
                <Property key="FontHeight" value="15"/>
                <Property key="NeedMouse" value="false"/>
                <Property key="TextAlign" value="Center"/>
                <Property key="TextShadow" value="true"/>
                <Property key="TextShadowColour" value="0 0 0"/>
                <Property key="Caption" value="0/0"/>
            </Widget>
					
        </Widget>
		
	        <!-- Drowning bar -->
        <Widget type="Window" skin="HUD_Box_NoTransp" position="45 184 190 7" align="Center Bottom" name="DrowningFrame">
            <Property key="Visible" value="false"/>
            <Widget type="Widget" skin="MW_Box" position="0 0 190 7" align="Stretch" name="BoundingBox"/>
            <Widget type="ProgressBar" skin="MW_Progress_Drowning_Full" position="0 0 190 7" align="Left Bottom" name="Drowning">
                <Property key="NeedMouse" value="false"/>
            </Widget>
            <Widget type="Widget" skin="MW_Progress_Drowning_Small" position="0 0 190 7" align="Left Bottom" name="Flash"/>
        </Widget>

		
		
        <Widget type="Button" skin="" position="10 164 200 26" align="Right Bottom" name="FatigueFrame">
            <UserString key="ToolTipType" value="Layout"/>
            <UserString key="ToolTipLayout" value="HealthToolTip"/>
            <UserString key="ImageTexture_HealthImage" value="icons\k\fatigue.dds"/>
            <Widget type="ProgressBar" skin="ArenaHUD_Bar_Stamina" position="30 4 170 17" align="Left Bottom" name="Stamina">
                <Property key="NeedMouse" value="false"/>
            </Widget>
            <Widget type="TextBox" skin="SandBrightText" position="30 4 170 17" align="Left Bottom" name="StaminaText">
                <Property key="FontHeight" value="15"/>
                <Property key="NeedMouse" value="false"/>
                <Property key="TextAlign" value="Center"/>
                <Property key="TextShadow" value="true"/>
                <Property key="TextShadowColour" value="0 0 0"/>
                <Property key="Caption" value="0/0"/>
            </Widget>
							<Widget type="ProgressBar" skin="ArenaHUD_ThinBar_Weapon" position="36 21 158 5" align="Center Bottom" name="WeapStatus">
                <Property key="NeedMouse" value="false"/>
            </Widget>
			
        <Widget type="Button" skin="" position="0 0 26 26" align="Right Bottom" name="WeapBox">
            <!-- Centered 16 px icon above icon_disc; icon_ring is drawn last
                 to frame it, keeping its corners inside the outer circle. -->
            <Widget type="Widget" skin="" position="0 0 26 26" name="WeapRing">
                <Property key="Visible" value="false"/>
                <Property key="NeedMouse" value="false"/>
                <Widget type="ImageBox" skin="ImageBox" position="0 0 26 26">
                    <Property key="ImageTexture" value="textures\ui\arenamw\hud\icon_disc.png"/>
                    <Property key="NeedMouse" value="false"/>
                </Widget>
                <Widget type="ItemWidget" skin="ArenaHUD_RoundIcon" position="5 5 16 16" name="WeapImage">
                    <Property key="NeedMouse" value="false"/>
                </Widget>
                <Widget type="ImageBox" skin="ImageBox" position="0 0 26 26">
                    <Property key="ImageTexture" value="textures\ui\arenamw\hud\icon_ring.png"/>
                    <Property key="NeedMouse" value="false"/>
                </Widget>
            </Widget>
        </Widget>
        </Widget>
		



        <!-- Equipped weapon/selected spell name display for a few seconds after it changes -->
        <Widget type="TextBox" skin="SandText" position="0 0 0 0" name="WeaponSpellName" align="Left Bottom HStretch">
            <Property key="Visible" value="false"/>
            <Property key="TextAlign" value="Left"/>
            <Property key="TextShadow" value="true"/>
            <Property key="TextShadowColour" value="0 0 0"/>
            <Property key="NeedMouse" value="false"/>
        </Widget>

      

        <!-- Sneak indicator box -->
            <!-- UI4: three-state eye (hidden / suspicious / detected), see HUD::updateSneakIndicator. -->
            <Widget type="Button" skin="" position="0 0 36 36" align="Center Center" name="SneakBox">
                <Property key="Visible" value="false"/>
                <Property key="NeedMouse" value="false"/>
                <Widget type="Widget" skin="" position="0 0 36 36">
                    <Property key="NeedMouse" value="false"/>
                    <Widget type="ImageBox" skin="ImageBox" position="0 0 36 36" align="Left Top" name="SneakImage">
                        <Property key="NeedMouse" value="false"/>
                        <Property key="ImageTexture" value="textures\ui\arenamw\hud\eye_hidden.png"/>
                    </Widget>
                </Widget>
            </Widget>

        <!-- Spell effects box -->
        <Widget type="Widget" skin="HUD_Box_Transparent" position="267 10 20 20" align="Right Top" name="EffectBox">
        </Widget>
		
		       <!-- Map box -->
        <Widget type="Widget" skin="" position="200 40 90 90" name="MiniMapBox" align="Right Top">
            <Widget type="Widget" skin="HUD_Box" position="0 0 90 90" align="Center">

                <Widget type="ScrollView" skin="MW_MapView" position="2 2 86 86" align="Left Bottom" name="MiniMap">
                    <Widget type="ImageBox" skin="RotatingSkin" position="0 0 30 30" align="Bottom Left" name="Compass">
                        <Property key="ImageTexture" value="textures\compass.dds"/>
                    </Widget>

                    <Widget type="Button" skin="" position_real="0 0 1 1" name="MiniMapButton" align="Stretch">
                        <Property key="Depth" value="10"/>
                    </Widget>

                </Widget>

            </Widget>
        </Widget>
		
		
        <Widget type="TextBox" skin="SandText" position="200 132 90 18" name="GameTime" align="Right Top">
            <Property key="TextAlign" value="Center"/>
            <Property key="TextShadow" value="true"/>
            <Property key="TextShadowColour" value="0 0 0"/>
            <Property key="NeedMouse" value="false"/>
            <Property key="Caption" value="00:00"/>
        </Widget>


  <!-- Mr.Zer0 OTF Team -->


        <!-- Cell name display when cell changes. The parent clips long names while HUD.cpp scrolls the text. -->
        <Widget type="Widget" skin="" position="0 40 300 30" name="CellNameClip" align="HCenter Top">
            <Property key="NeedMouse" value="false"/>
            <Widget type="TextBox" skin="SandText" position="0 0 300 30" name="CellName" align="Left Top">
                <Property key="Visible" value="false"/>
                <Property key="TextAlign" value="Center"/>
                <Property key="TextShadow" value="true"/>
                <Property key="TextShadowColour" value="0 0 0"/>
                <Property key="NeedMouse" value="false"/>
            </Widget>
        </Widget>

 

        <!-- Y046d: frameless recovery HUD below screen centre. Prompt is explicitly
             composed as at most two lines in HUD.cpp; TextBox does not use the
             unsupported MultiLine/WordWrap properties. -->
        <Widget type="Widget" skin="" position="-150 -150 600 114" align="Center Bottom" name="DeathRecoveryPanel">
            <Property key="Visible" value="false"/>
            <Property key="NeedMouse" value="false"/>
            <Widget type="TextBox" skin="SandBrightText" position="0 0 600 19" name="DeathRecoveryTitle">
                <Property key="TextAlign" value="Center VCenter"/>
                <Property key="TextShadow" value="true"/>
                <Property key="TextShadowColour" value="0 0 0"/>
                <Property key="NeedMouse" value="false"/>
            </Widget>
            <Widget type="ProgressBar" skin="ArenaHUD_Bar_XP" position="40 22 520 18" name="DeathRecoveryXpBar">
                <Property key="NeedMouse" value="false"/>
            </Widget>
            <!-- UI9.2: knock-out, respawn and bounty timers use the red health bar. -->
            <Widget type="ProgressBar" skin="ArenaHUD_Bar_Health" position="40 22 520 18" name="DeathRecoveryRedBar">
                <Property key="Visible" value="false"/>
                <Property key="NeedMouse" value="false"/>
            </Widget>
            <Widget type="TextBox" skin="SandBrightText" position="40 22 520 18" name="DeathRecoveryXpText">
                <Property key="TextAlign" value="Center VCenter"/>
                <Property key="TextShadow" value="true"/>
                <Property key="TextShadowColour" value="0 0 0"/>
                <Property key="NeedMouse" value="false"/>
            </Widget>
            <Widget type="TextBox" skin="SandText" position="0 46 600 40" name="DeathRecoveryPrompt">
                <Property key="TextAlign" value="Center Top"/>
                <Property key="TextShadow" value="true"/>
                <Property key="TextShadowColour" value="0 0 0"/>
                <Property key="NeedMouse" value="false"/>
            </Widget>
            <Widget type="TextBox" skin="SandBrightText" position="0 92 600 18" name="DeathRecoveryAction">
                <Property key="Visible" value="false"/>
                <Property key="TextAlign" value="Center VCenter"/>
                <Property key="TextShadow" value="true"/>
                <Property key="TextShadowColour" value="0 0 0"/>
                <Property key="NeedMouse" value="false"/>
            </Widget>
        </Widget>

        <!-- Crosshair. UI9: an empty 64x64 box; HUD::setupDynamicCrosshair adds
             the reticle (dot + four chevrons) and the contextual icon. -->
        <Widget type="ImageBox" skin="ImageBox" position="118 68 64 64" align="Center Center" name="Crosshair">
            <Property key="NeedMouse" value="false"/>
        </Widget>

        </Widget>
    </Widget>
</MyGUI>
