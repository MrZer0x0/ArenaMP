    <!-- ArenaMP UI9.3: shaped fills. Each fill has exactly the glass shape of
         its backplate (same size and 3-slice cuts), so a full bar fills the
         pointed ends but never covers the bronze rim. The track holds the fill
         as the child "Client"; MWGui::fitShapedProgressBar() pins it to the
         bar's full width so the growing track only reveals it from the left.
         Without that call the fill simply stretches with the track. -->
    <Resource type="ResourceSkin" name="ArenaHUD_Shape_Health" size="64 16" texture="textures\ui\arenamw\hud\shape_health.png">
        <BasisSkin type="SubSkin" offset="0 0 10 16" align="Left VStretch">
            <State name="normal" offset="0 0 10 16"/>
        </BasisSkin>
        <BasisSkin type="SubSkin" offset="10 0 44 16" align="HStretch VStretch">
            <State name="normal" offset="10 0 44 16"/>
        </BasisSkin>
        <BasisSkin type="SubSkin" offset="54 0 10 16" align="Right VStretch">
            <State name="normal" offset="54 0 10 16"/>
        </BasisSkin>
    </Resource>
    <Resource type="ResourceSkin" name="ArenaHUD_ShapedTrack_Health" size="64 16">
        <Child type="Widget" skin="ArenaHUD_Shape_Health" offset="0 0 64 16" align="Stretch" name="Client">
            <Property key="NeedMouse" value="false"/>
        </Child>
    </Resource>
