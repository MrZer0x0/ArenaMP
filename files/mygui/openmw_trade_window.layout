<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Window" layer="Windows" position="0 0 700 440" name="_Main">
        <Property key="Visible" value="false"/>
        <Property key="MinSize" value="500 460"/>

        <!-- UI8: the same filter column as the player inventory (icons, names
             in the tooltips, laid out by ArenaUi::layoutFilterColumn). The rows
             below start under the list. -->
        <Widget type="Widget" skin="" position="8 8 34 286" align="Left Top VStretch" name="Categories">
            <Widget type="Button" skin="MW_Button" position="0 0 34 28" name="AllButton"><Property key="NeedKey" value="false"/></Widget>
            <Widget type="Button" skin="MW_Button" position="0 32 34 28" name="WeaponButton"><Property key="NeedKey" value="false"/></Widget>
            <Widget type="Button" skin="MW_Button" position="0 64 34 28" name="ApparelButton"><Property key="NeedKey" value="false"/></Widget>
            <Widget type="Button" skin="MW_Button" position="0 96 34 28" name="MagicButton"><Property key="NeedKey" value="false"/></Widget>
            <Widget type="Button" skin="MW_Button" position="0 128 34 28" name="MiscButton"><Property key="NeedKey" value="false"/></Widget>
            <Widget type="Button" skin="MW_Button" position="0 160 34 28" name="KeysButton"><Property key="NeedKey" value="false"/></Widget>
        </Widget>

        <Widget type="ItemView" skin="MW_ItemView" position="46 8 628 286" name="ItemView" align="Left Top Stretch"></Widget>

        <Widget type="TextBox" skin="NormalText" position="46 296 482 26" name="EconomicStatus" align="Left Bottom HStretch"><Property key="Caption" value="#{arenamp=ce.wait}"/><Property key="NeedMouse" value="false"/></Widget>
        <Widget type="Button" skin="MW_Button" position="534 296 140 28" name="MarketButton" align="Right Bottom"><Property key="Caption" value="#{arenamp=ce.market}"/></Widget>
        <!-- UI8: the view toggle sits under the filter column, like the inventory's. -->
        <Widget type="Button" skin="MW_Button" position="8 332 34 26" name="ViewModeButton" align="Left Bottom"><Property key="Caption" value=""/></Widget>
        <!-- Row 1 mirrors the player bottom bar: transaction controls, search, merchant gold. -->
        <Widget type="Widget" skin="" position="46 330 628 68" name="BottomPane" align="Left Bottom HStretch">
            <Widget type="Button" skin="MW_Button" position="0 2 30 26" name="IncreaseButton" align="Left Top"><Property key="Caption" value="+"/><Property key="NeedKey" value="false"/></Widget>
            <Widget type="NumericEditBox" skin="MW_TextEdit" position="36 2 82 26" name="TotalBalance" align="Left Top"><Property key="TextAlign" value="Center"/></Widget>
            <Widget type="Button" skin="MW_Button" position="124 2 30 26" name="DecreaseButton" align="Left Top"><Property key="Caption" value="-"/><Property key="NeedKey" value="false"/></Widget>
            <Widget type="EditBox" skin="MW_TextBoxEditWithBorder" position="160 2 398 26" name="FilterEdit" align="Left Top HStretch"><UserString key="AcceptTab" value="true"/></Widget>
            <!-- Merchant gold is rendered as a compact inventory-style stack:
                 coin icon with the amount overlaid in the lower-right corner. -->
            <Widget type="ImageBox" skin="ImageBox" position="590 1 30 30" name="MerchantGoldIcon" align="Right Top"><Property key="NeedMouse" value="false"/></Widget>
            <Widget type="TextBox" skin="CountText" position="590 1 30 30" name="MerchantGold" align="Right Top"><Property key="NeedMouse" value="false"/><Property key="TextAlign" value="Right Bottom"/><Property key="TextShadow" value="true"/></Widget>

            <!-- Kept only for code compatibility; deliberately invisible. -->
            <Widget type="TextBox" skin="SandText" position="0 34 1 1" name="TotalBalanceLabel" align="Left Bottom"><Property key="Visible" value="false"/></Widget>

            <!-- Row 2: barter actions, lifted fully inside the window. -->
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 36 0 26" name="MaxSaleButton" align="Left Bottom"><Property key="Caption" value="#{sMaxSale}"/></Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" position="150 36 0 26" name="SingleTransferButton" align="Left Bottom"><Property key="Caption" value="#{arenamp=inventory.single_transfer_on}"/><Property key="NeedKey" value="false"/></Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" position="452 40 0 26" name="OfferButton" align="Right Bottom"><Property key="Caption" value="#{sBarterDialog8}"/></Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" position="552 40 0 26" name="CancelButton" align="Right Bottom"><Property key="Caption" value="#{sCancel}"/></Widget>
        </Widget>
    </Widget>
</MyGUI>
