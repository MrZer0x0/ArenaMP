<MyGUI type="Layout" version="3.2.0">
  <!-- QS1: Quest Studio, authored at its smallest size (760x480). The window
       grows to the viewport and only lists and text fields stretch; buttons and
       fonts keep their size. Icon buttons get their icon and tooltip from
       ServerQuestEditorWindow::decorateButtons. Captions are placeholders replaced
       by the localised strings. -->
