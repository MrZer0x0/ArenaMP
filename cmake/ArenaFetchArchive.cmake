# Fetch a pinned source archive without making a transient mirror outage fatal.
# The caller supplies immutable revision URLs; TLS verification stays enabled.
function(arena_fetch_archive output archive)
    get_filename_component(_directory "${archive}" DIRECTORY)
    file(MAKE_DIRECTORY "${_directory}")
    file(LOCK "${archive}.lock" GUARD FUNCTION TIMEOUT 180 RESULT_VARIABLE _lock)
    if(NOT "${_lock}" STREQUAL "0")
        message(FATAL_ERROR "Cannot lock source archive cache: ${_lock}")
    endif()
    if(EXISTS "${archive}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
            RESULT_VARIABLE _valid OUTPUT_QUIET ERROR_QUIET)
        if("${_valid}" STREQUAL "0")
            set(${output} "${archive}" PARENT_SCOPE)
            return()
        endif()
        message(STATUS "Discarding invalid cached archive: ${archive}")
        file(REMOVE "${archive}")
    endif()
    set(_errors "")
    foreach(_round RANGE 1 3)
        if(_round GREATER 1)
            math(EXPR _delay "2 * (${_round} - 1)")
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep "${_delay}")
        endif()
        foreach(_url IN LISTS ARGN)
            message(STATUS "Fetching source archive (attempt ${_round}/3): ${_url}")
            file(REMOVE "${archive}.part")
            file(DOWNLOAD "${_url}" "${archive}.part" STATUS _status
                TLS_VERIFY ON TIMEOUT 90 INACTIVITY_TIMEOUT 30)
            list(GET _status 0 _code)
            list(GET _status 1 _reason)
            if(_code EQUAL 0)
                execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}.part"
                    RESULT_VARIABLE _valid OUTPUT_QUIET ERROR_QUIET)
                if("${_valid}" STREQUAL "0")
                    file(RENAME "${archive}.part" "${archive}")
                    set(${output} "${archive}" PARENT_SCOPE)
                    return()
                endif()
                set(_reason "response is not a readable source archive")
            endif()
            file(REMOVE "${archive}.part")
            string(APPEND _errors "\n  attempt ${_round}: ${_url}: ${_reason}")
        endforeach()
    endforeach()
    message(FATAL_ERROR "Source archive unavailable after retries.${_errors}\n"
        "Retry later, restore the archive cache, or provide this dependency's offline sources. "
        "No feature has been silently disabled.")
endfunction()
